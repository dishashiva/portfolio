---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
    {
        id: "01",
        category: "WEB APP",
        title: "AgriConnect",
        description:
            "A PWA connecting farmers to markets via OTP-based login, featuring AI-powered crop health scanning and transaction logging.",
        image: "/assets/proj-1.jpg",
        tags: ["React", "Node"],
        link: "https://github.com/Dqrshan/agri-connect",
    },
    {
        id: "02",
        category: "UI/UX",
        title: "Synaptic Fitness",
        description:
            "A MVP for real-time posture tracking and auto-generated workouts for mental and physical fitness.",
        image: "/assets/proj-2.jpg",
        tags: ["Figma", "Prototyping"],
        link: "https://github.com/dishashiva",
    },
    {
        id: "03",
        category: "WEB APP",
        title: "Social Connect",
        description: "An AI-based social media moderation system.",
        image: "/assets/proj-3.jpg",
        tags: ["Agile", "Node"],
        link: "https://github.com/dishashiva/Mini-Project",
    },
    {
        id: "04",
        category: "WEB APP",
        title: "Commune Connect",
        description:
            "A real-time social platform with AI group summarization and SOS alerts.",
        image: "/assets/proj-4.jpg",
        tags: ["Next.js", "Python"],
        link: "https://github.com/Dqrshan/commune-connect",
    },
];
---

<Layout title="Work // Disha S">
    <section class="max-w-6xl mx-auto px-6 md:px-10 pt-32 md:pt-40 pb-20">
        <p class="reveal text-xs font-medium uppercase tracking-widest text-ink-faint mb-3">Projects</p>
        <h1 class="reveal serif text-4xl md:text-6xl italic mb-4" style="transition-delay: 0.06s">Selected work.</h1>
        <p class="reveal text-sm text-ink-muted max-w-md" style="transition-delay: 0.12s">
            Technical creations, design experiments, and managed projects.
        </p>
    </section>

    <section class="max-w-6xl mx-auto px-6 md:px-10 pb-24 md:pb-32">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {projects.map((project, i) => (
                <div class="reveal" style={`transition-delay: ${i * 0.08}s`}>
                    <ProjectCard
                        id={project.id}
                        category={project.category}
                        title={project.title}
                        description={project.description}
                        image={project.image}
                        tags={project.tags}
                        link={project.link}
                    />
                </div>
            ))}
        </div>
    </section>
</Layout>
