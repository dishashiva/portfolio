---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects: {
    id: string;
    category: string;
    title: string;
    description: string;
    image: string;
    theme: "pink" | "yellow" | "red";
    tags: string[];
    filterClass?: string;
    mtClass?: string;
    link?: string;
}[] = [
    {
        id: "01",
        category: "WEB APP",
        title: "Agri<br>Connect",
        description:
            "A PWA that connects farmers to markets via OTP-based login, featuring AI-powered crop health scanning and transaction logging.",
        image: "/assets/proj-1.jpg",
        theme: "pink",
        tags: ["REACT", "NODE"],
        link: "https://github.com/Dqrshan/agri-connect",
    },
    {
        id: "02",
        category: "UI/UX",
        title: "Synaptic<br>Fitness",
        description:
            "A MVP for real-time posture tracking and auto-generated workouts for mental and physical fitness.",
        image: "/assets/proj-2.jpg",
        theme: "yellow",
        tags: ["FIGMA", "PROTOTYPING"],
        mtClass: "md:translate-y-16",
        link: "https://github.com/dishashiva",
    },
    {
        id: "03",
        category: "WEB APP",
        title: "Social<br>Connect​",
        description: "An AI-based social media moderation system.",
        image: "/assets/proj-3.jpg",
        theme: "red",
        filterClass: "filter sepia",
        tags: ["AGILE", "NODE"],
        link: "https://github.com/dishashiva/Mini-Project",
    },
    {
        id: "04",
        category: "WEB APP",
        title: "Commune<br>Connect​",
        description:
            "A real-time social platform with AI group summarization and SOS alerts.",
        image: "/assets/proj-4.jpg",
        theme: "pink",
        filterClass: "filter blur-[1px]",
        mtClass: "md:translate-y-16",
        tags: ["NEXT.JS", "PYTHON"],
        link: "https://github.com/Dqrshan/commune-connect",
    },
];
---

<Layout title="Projects // Disha S">
    <section class="mb-20">
        <h1 class="serif text-5xl md:text-8xl mb-6">
            Featured <span class="text-gradient italic">Works.</span>
        </h1>
        <p class="max-w-md text-lg text-neutral-600">
            A showcase of technical creations, design experiments, and fully
            managed projects.
        </p>
    </section>

    <!-- Projects Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-40">
        {
            projects.map((project) => (
                <ProjectCard
                    id={project.id}
                    category={project.category}
                    title={project.title}
                    description={project.description}
                    image={project.image}
                    theme={project.theme}
                    tags={project.tags}
                    filterClass={project.filterClass}
                    mtClass={project.mtClass}
                    link={project.link}
                />
            ))
        }
    </section>

    <!-- GitHub Profile Section -->
    <!-- <section
