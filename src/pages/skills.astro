---
import Layout from "../layouts/Layout.astro";
import SkillCard from "../components/SkillCard.astro";

const categories = [
    {
        label: "Frontend",
        skills: [
            { title: "React", icon: "code" },
            { title: "Astro", icon: "code" },
            { title: "Tailwind CSS", icon: "code" },
            { title: "JavaScript", icon: "code" },
        ],
    },
    {
        label: "Backend",
        skills: [
            { title: "Node.js", icon: "database" },
            { title: "Python", icon: "database" },
            { title: "SQL", icon: "database" },
        ],
    },
    {
        label: "Design",
        skills: [
            { title: "Figma", icon: "pen-tool" },
            { title: "UI/UX", icon: "pen-tool" },
            { title: "Prototyping", icon: "pen-tool" },
        ],
    },
    {
        label: "DevOps",
        skills: [
            { title: "AWS", icon: "server" },
            { title: "Vercel", icon: "server" },
            { title: "CI/CD", icon: "server" },
        ],
    },
    {
        label: "Tools",
        skills: [
            { title: "GitHub", icon: "git-branch" },
            { title: "VS Code", icon: "layout" },
            { title: "Notion", icon: "layout" },
            { title: "Canva", icon: "layout" },
        ],
    },
    {
        label: "Soft Skills",
        skills: [
            { title: "Communication", icon: "message-square" },
            { title: "Leadership", icon: "users" },
            { title: "Mentorship", icon: "users" },
            { title: "Agile", icon: "users" },
        ],
    },
];
---

<Layout title="Skills // Disha S">
    <section class="max-w-6xl mx-auto px-6 md:px-10 pt-32 md:pt-40 pb-20">
        <p class="reveal text-xs font-medium uppercase tracking-widest text-ink-faint mb-3">Capabilities</p>
        <h1 class="reveal serif text-4xl md:text-6xl italic mb-4" style="transition-delay: 0.06s">What I work with.</h1>
        <p class="reveal text-sm text-ink-muted max-w-md" style="transition-delay: 0.12s">
            A comprehensive view across the development stack and design tools.
        </p>
    </section>

    <section class="max-w-6xl mx-auto px-6 md:px-10 pb-24 md:pb-32 space-y-16">
        {categories.map((cat, ci) => (
            <div class="reveal" style={`transition-delay: ${ci * 0.06}s`}>
                <p class="text-xs font-medium uppercase tracking-widest text-ink-faint mb-5">{cat.label}</p>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                    {cat.skills.map((skill) => (
                        <SkillCard
                            title={skill.title}
                            icon={skill.icon}
                        />
                    ))}
                </div>
            </div>
        ))}
    </section>
</Layout>
