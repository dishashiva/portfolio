---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 // Disha S" description="Page not found.">
    <section class="max-w-6xl mx-auto px-6 md:px-10 pt-32 md:pt-44 pb-32 flex flex-col items-center text-center">
        <p class="serif text-8xl md:text-9xl text-border mb-6">404</p>
        <h1 class="serif text-2xl md:text-3xl italic mb-4">Page not found</h1>
        <p class="text-sm text-ink-muted mb-8">The page you're looking for doesn't exist or has been moved.</p>
        <a href="/" class="btn-primary">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M13 7H1M6 2L1 7l5 5"/>
            </svg>
            Back to home
        </a>
    </section>
</Layout>
