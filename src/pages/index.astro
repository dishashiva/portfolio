---
import Layout from "../layouts/Layout.astro";
import ExperienceItem from "../components/ExperienceItem.astro";

const professionalExperiences = [
  {
    date: "Jun 2026 — Present",
    title: "Virtual Intern (AI)",
    company: "Infosys Springboard",
    logo: "https://upload.wikimedia.org/wikipedia/commons/9/95/Infosys_logo.svg",
    description: "Built an AI-Powered Career Guidance Platform. Implemented ATS resume parsing, skill-based course & certification recommendations, customized job listings, tailored career pathways, and an interactive AI chat assistant.",
    tags: ["React", "ATS Parser", "AI Chat Assistant", "Infosys"]
  }
];

const volunteeringExperiences = [
  {
    date: "Feb 2026 — Present",
    title: "Developer Relations & Operations Lead",
    company: "AWS Student Builder Group at Atria Institute of Technology",
    logo: "https://darshan.is-a.dev/logos/AWSSBG.webp",
    description: "Leading Developer Relations across campus. Organizing cloud computing workshops, hackathons, and technical mentoring for student developers.",
    tags: ["AWS", "DevRel", "Community Building", "Leadership"]
  },
  {
    date: "Nov 2025 — Feb 2026",
    title: "Technical Team Member",
    company: "ISTE Atria Student Chapter",
    logo: "https://darshan.is-a.dev/logos/ISTE.webp",
    description: "Contributed to student technical chapter initiatives, technical event organization, and hands-on developer workshops.",
    tags: ["Technical Events", "Workshops", "Peer Mentoring"]
  },
  {
    date: "Jun 2024 — Jun 2025",
    title: "Club Service Director",
    company: "Rotaract Club of Atria I.T.",
    logo: "https://darshan.is-a.dev/logos/Rotary.webp",
    description: "Directed club service operations, community service projects, team building, and leadership campaigns.",
    tags: ["Club Service", "Team Operations", "Leadership"]
  }
];
---

<Layout title="Disha S — Developer & DevRel">
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 pt-32 md:pt-44 pb-20 md:pb-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        <p class="reveal text-xs font-medium uppercase tracking-widest text-ink-faint mb-6">
          Student &middot; Developer &middot; DevRel
        </p>

        <h1 class="reveal serif text-5xl md:text-7xl lg:text-8xl leading-[0.95] mb-8" style="transition-delay: 0.06s">
          Hi, I'm<br />
          <span class="italic text-accent">Disha.</span>
        </h1>

        <p class="reveal text-base md:text-lg text-ink-muted leading-relaxed max-w-xl mb-10" style="transition-delay: 0.12s">
          A student developer exploring the intersections of software engineering,
          UI/UX design, and community building. Currently leading Developer Relations
          at AWS Student Builder Group.
        </p>

        <div class="reveal flex flex-wrap gap-3" style="transition-delay: 0.18s">
          <a href="/projects" class="btn-primary">
            View work
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M1 7h12M8 2l5 5-5 5"/>
            </svg>
          </a>
          <a href="/skills" class="btn-outline">Skills</a>
        </div>
      </div>

      <div class="lg:col-span-5 reveal" style="transition-delay: 0.1s">
        <div class="aspect-square max-w-sm mx-auto rounded-full overflow-hidden bg-surface-warm">
          <img
            src="/assets/photo.png"
            alt="Disha — Student Developer"
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <section class="border-y border-border-subtle py-5 overflow-hidden reveal">
    <div class="marquee-track">
      <span class="text-sm font-light text-ink-faint px-8 whitespace-nowrap tracking-wide">Frontend · Backend · UI/UX · DevOps · Community · Leadership · React · Astro · Node · Python · AWS · Figma · TypeScript · Agile</span>
      <span class="text-sm font-light text-ink-faint px-8 whitespace-nowrap tracking-wide" aria-hidden="true">Frontend · Backend · UI/UX · DevOps · Community · Leadership · React · Astro · Node · Python · AWS · Figma · TypeScript · Agile</span>
    </div>
  </section>

  <!-- Experience with Tab Switcher -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-24 md:py-32">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <p class="reveal text-xs font-medium uppercase tracking-widest text-ink-faint mb-3">Experience</p>
        <h2 class="reveal serif text-3xl md:text-5xl italic" style="transition-delay: 0.06s">Where I've been.</h2>
      </div>

      <!-- Tab Switcher -->
      <div class="reveal flex p-1 bg-surface-warm border border-border-subtle rounded-full w-fit" style="transition-delay: 0.12s">
        <button
          id="tab-btn-professional"
          class="tab-btn active px-5 py-2 text-xs font-semibold tracking-wider uppercase rounded-full transition-all duration-300 cursor-pointer bg-ink text-surface"
          aria-controls="tab-panel-professional"
        >
          Professional
        </button>
        <button
          id="tab-btn-volunteering"
          class="tab-btn px-5 py-2 text-xs font-semibold tracking-wider uppercase rounded-full transition-all duration-300 text-ink-muted hover:text-ink cursor-pointer"
          aria-controls="tab-panel-volunteering"
        >
          Volunteering
        </button>
      </div>
    </div>

    <!-- Tab Panels -->
    <div>
      <!-- Professional Panel -->
      <div id="tab-panel-professional" class="tab-panel space-y-0">
        {professionalExperiences.map((exp) => (
          <ExperienceItem
            date={exp.date}
            title={exp.title}
            company={exp.company}
            logo={exp.logo}
            description={exp.description}
            tags={exp.tags}
          />
        ))}
      </div>

      <!-- Volunteering Panel -->
      <div id="tab-panel-volunteering" class="tab-panel hidden space-y-0">
        {volunteeringExperiences.map((exp) => (
          <ExperienceItem
            date={exp.date}
            title={exp.title}
            company={exp.company}
            logo={exp.logo}
            description={exp.description}
            tags={exp.tags}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- DevRel Note -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 pb-20 md:pb-28">
    <div class="reveal border border-border-subtle rounded-2xl p-10 md:p-14">
      <p class="text-xs font-medium uppercase tracking-widest text-ink-faint mb-4">DevRel & Community</p>
      <h3 class="serif text-2xl md:text-3xl italic mb-4">Passionate about developer communities.</h3>
      <p class="text-sm text-ink-muted leading-relaxed max-w-lg">
        Currently leading Developer Relations at AWS Student Builder Group, organizing workshops,
        and mentoring peers in cloud technologies. I believe great tools deserve great communities.
      </p>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 pb-24 md:pb-32">
    <div class="reveal border-t border-border-subtle pt-16">
      <p class="text-xs font-medium uppercase tracking-widest text-ink-faint mb-3">Get in touch</p>
      <h2 class="serif text-3xl md:text-4xl italic mb-4">Let's work together.</h2>
      <p class="text-sm text-ink-muted leading-relaxed max-w-md mb-8">
        Open to internships, collaborations, and DevRel opportunities.
        Drop me a line — I'd love to hear from you.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="mailto:dishashiva11@gmail.com" class="btn-primary">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="1" y="3" width="12" height="9" rx="1.5"/>
            <path d="M1 4l6 4 6-4"/>
          </svg>
          Email me
        </a>
        <a href="https://linkedin.com/in/dishas05" target="_blank" rel="noopener noreferrer" class="btn-outline">LinkedIn</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnProfessional = document.getElementById('tab-btn-professional');
    const btnVolunteering = document.getElementById('tab-btn-volunteering');
    const panelProfessional = document.getElementById('tab-panel-professional');
    const panelVolunteering = document.getElementById('tab-panel-volunteering');

    btnProfessional?.addEventListener('click', () => {
      btnProfessional.classList.add('bg-ink', 'text-surface');
      btnProfessional.classList.remove('text-ink-muted');
      
      btnVolunteering?.classList.remove('bg-ink', 'text-surface');
      btnVolunteering?.classList.add('text-ink-muted');

      panelProfessional?.classList.remove('hidden');
      panelVolunteering?.classList.add('hidden');
    });

    btnVolunteering?.addEventListener('click', () => {
      btnVolunteering.classList.add('bg-ink', 'text-surface');
      btnVolunteering.classList.remove('text-ink-muted');

      btnProfessional?.classList.remove('bg-ink', 'text-surface');
      btnProfessional?.classList.add('text-ink-muted');

      panelVolunteering?.classList.remove('hidden');
      panelProfessional?.classList.add('hidden');
    });
  });
</script>

