---
import Layout from "../layouts/Layout.astro";
import ExperienceItem from "../components/ExperienceItem.astro";

const experiences = [
  {
    date: "Mar 2026 — Present",
    title: "Developer Relations & Operations Lead",
    company: "AWS Student Builder Group at Atria Institute of Technology",
    icon: "cloud",
    theme: "accent" as const,
  },
  {
    date: "Nov 2025 — Present",
    title: "Technical Team Member",
    company: "ISTE Atria Student Chapter",
    icon: "code",
    theme: "muted" as const,
  },
  {
    date: "Jun 2024 — Jun 2025",
    title: "Club Service Director",
    company: "Rotaract Club of Atria I.T.",
    icon: "pen-tool",
    theme: "warm" as const,
  },
];
---

<Layout title="Disha S — Developer & DevRel">
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 pt-32 md:pt-44 pb-20 md:pb-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        <p class="reveal text-xs font-medium uppercase tracking-widest text-ink-faint mb-6">
          Student &middot; Developer &middot; DevRel
        </p>

        <h1 class="reveal serif text-5xl md:text-7xl lg:text-8xl leading-[0.95] mb-8" style="transition-delay: 0.06s">
          Hi, I'm<br />
          <span class="italic text-accent">Disha.</span>
        </h1>

        <p class="reveal text-base md:text-lg text-ink-muted leading-relaxed max-w-xl mb-10" style="transition-delay: 0.12s">
          A student developer exploring the intersections of software engineering,
          UI/UX design, and community building. Currently leading Developer Relations
          at AWS Student Builder Group.
        </p>

        <div class="reveal flex flex-wrap gap-3" style="transition-delay: 0.18s">
          <a href="/projects" class="btn-primary">
            View work
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M1 7h12M8 2l5 5-5 5"/>
            </svg>
          </a>
          <a href="/skills" class="btn-outline">Skills</a>
        </div>
      </div>

      <div class="lg:col-span-5 reveal" style="transition-delay: 0.1s">
        <div class="aspect-square max-w-sm mx-auto rounded-full overflow-hidden bg-surface-warm">
          <img
            src="/assets/photo.png"
            alt="Disha — Student Developer"
            loading="eager"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <section class="border-y border-border-subtle py-5 overflow-hidden reveal">
    <div class="marquee-track">
      <span class="text-sm font-light text-ink-faint px-8 whitespace-nowrap tracking-wide">Frontend · Backend · UI/UX · DevOps · Community · Leadership · React · Astro · Node · Python · AWS · Figma · TypeScript · Agile</span>
      <span class="text-sm font-light text-ink-faint px-8 whitespace-nowrap tracking-wide" aria-hidden="true">Frontend · Backend · UI/UX · DevOps · Community · Leadership · React · Astro · Node · Python · AWS · Figma · TypeScript · Agile</span>
    </div>
  </section>

  <!-- Experience -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 py-24 md:py-32">
    <div class="mb-14">
      <p class="reveal text-xs font-medium uppercase tracking-widest text-ink-faint mb-3">Experience</p>
      <h2 class="reveal serif text-3xl md:text-4xl italic" style="transition-delay: 0.06s">Where I've been</h2>
    </div>

    <div class="space-y-0">
      {experiences.map((exp, i) => (
        <div class="reveal" style={`transition-delay: ${i * 0.08}s`}>
          <ExperienceItem
            date={exp.date}
            title={exp.title}
            company={exp.company}
            icon={exp.icon}
            theme={exp.theme}
          />
        </div>
      ))}
    </div>
  </section>

  <!-- DevRel Note -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 pb-20 md:pb-28">
    <div class="reveal border border-border-subtle rounded-2xl p-10 md:p-14">
      <p class="text-xs font-medium uppercase tracking-widest text-ink-faint mb-4">DevRel & Community</p>
      <h3 class="serif text-2xl md:text-3xl italic mb-4">Passionate about developer communities.</h3>
      <p class="text-sm text-ink-muted leading-relaxed max-w-lg">
        Currently leading Developer Relations at AWS Student Builder Group, organizing workshops,
        and mentoring peers in cloud technologies. I believe great tools deserve great communities.
      </p>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="max-w-6xl mx-auto px-6 md:px-10 pb-24 md:pb-32">
    <div class="reveal border-t border-border-subtle pt-16">
      <p class="text-xs font-medium uppercase tracking-widest text-ink-faint mb-3">Get in touch</p>
      <h2 class="serif text-3xl md:text-4xl italic mb-4">Let's work together.</h2>
      <p class="text-sm text-ink-muted leading-relaxed max-w-md mb-8">
        Open to internships, collaborations, and DevRel opportunities.
        Drop me a line — I'd love to hear from you.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="mailto:dishashiva11@gmail.com" class="btn-primary">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="1" y="3" width="12" height="9" rx="1.5"/>
            <path d="M1 4l6 4 6-4"/>
          </svg>
          Email me
        </a>
        <a href="https://linkedin.com/in/dishas05" target="_blank" rel="noopener noreferrer" class="btn-outline">LinkedIn</a>
      </div>
    </div>
  </section>
</Layout>
