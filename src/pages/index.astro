---
import Layout from "../layouts/Layout.astro";
import ExperienceItem from "../components/ExperienceItem.astro";

const experiences: {
    date: string;
    title: string;
    company: string;
    icon: string;
    theme: "pink" | "yellow" | "red";
}[] = [
    {
        date: "Nov 2025 - Present",
        title: "Technical Team Member",
        company: "ISTE Atria Student Chapter",
        icon: "code",
        theme: "pink",
    },
    {
        date: "Jun 2024 - Jun 2025",
        title: "Club Service Director",
        company: "Rotaract Club of Atria I.T.",
        icon: "pen-tool",
        theme: "yellow",
    },
    // uncomment to add another experience!
    // { date: '2023 - 2024', title: 'Project Manager', company: 'University Tech Hub', icon: 'users', theme: 'red' }
];
---

<Layout title="About // Disha S">
    <!-- Hero / About Combined Section -->
    <section class="mb-40 fade-in pt-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <div
                class="lg:col-span-7 flex flex-col justify-center relative z-10"
            >
                <div
                    class="px-4 py-1 rounded-full border border-pink text-pink text-[10px] font-bold uppercase mb-8 flex items-center gap-2 w-max"
                >
                    <i data-lucide="zap" class="w-3 h-3"></i> Student & Developer
                </div>

                <h1
                    class="serif text-6xl md:text-[7.5rem] leading-[0.85] mb-10"
                >
                    Building <br />
                    <span class="text-gradient italic">The Future.</span>
                </h1>

                <div
                    class="glass-card rounded-3xl p-8 mb-10 w-full md:w-11/12 xl:w-5/6"
                >
                    <p class="text-lg text-neutral-600 leading-relaxed mb-6">
                        I am a dedicated student and developer, exploring the
                        intersections of software engineering, UI/UX design, and
                        project management. Crafting robust applications where <b
                            >innovative logic</b
                        > meets <b>premium design</b>.
                    </p>
                    <div class="flex gap-4">
                        <span
                            class="text-[10px] font-bold py-1 px-3 border border-dark-green rounded-full"
                            >DEVELOPMENT</span
                        >
                        <span
                            class="text-[10px] font-bold py-1 px-3 border border-dark-green rounded-full"
                            >DESIGN</span
                        >
                        <span
                            class="text-[10px] font-bold py-1 px-3 border border-dark-green rounded-full"
                            >PROJECTS</span
                        >
                    </div>
                </div>

                <a
                    href="/projects"
                    class="btn-premium flex items-center gap-2 w-max"
                >
                    View My Work <i data-lucide="arrow-right" class="w-5 h-5"
                    ></i>
                </a>
            </div>

            <div
                class="hidden lg:block lg:col-span-5 w-full aspect-[4/5] rounded-[2rem] overflow-hidden group glass-card p-4"
            >
                <div
                    class="w-full h-full rounded-[1.5rem] overflow-hidden relative"
                >
                    <div
                        class="absolute inset-0 bg-gradient-to-tr from-pink/20 to-yellow/20 z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 mix-blend-overlay"
                    >
                    </div>
                    <img
                        src="/assets/photo.png"
                        alt="Profile"
                        class="w-full h-full object-cover filter grayscale opacity-90 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Experience Section -->
    <section class="mb-20">
        <h2 class="serif text-5xl md:text-6xl mb-16 text-center">
            My Experience
        </h2>

        <div
            class="space-y-6 max-w-4xl mx-auto relative before:absolute before:inset-y-0 before:w-0.5 before:left-[1.75rem] md:before:left-1/2 before:-translate-x-1/2 before:bg-gradient-to-b before:from-pink before:via-yellow before:to-dark-green/20"
        >
            {
                experiences.map((exp) => (
                    <ExperienceItem
                        date={exp.date}
                        title={exp.title}
                        company={exp.company}
                        icon={exp.icon}
                        theme={exp.theme}
                    />
                ))
            }
        </div>
    </section>
</Layout>
