---
interface Props {
	id: string;
	category: string;
	title: string;
	description: string;
	image: string;
	tags: string[];
	link?: string;
}

const { id, category, title, description, image, tags, link = "#" } = Astro.props;
---

<a href={link} target="_blank" rel="noopener noreferrer" class="card block group">
    <div class="flex flex-col md:flex-row">
        <!-- Text -->
        <div class="flex-1 p-6 md:p-8 flex flex-col justify-between order-2 md:order-1">
            <div>
                <span class="text-[10px] font-medium uppercase tracking-widest text-ink-faint mb-3 block">{id} / {category}</span>
                <h3 class="font-medium text-xl md:text-2xl mb-3 text-ink group-hover:text-accent transition-colors duration-300">{title}</h3>
                <p class="text-sm text-ink-muted leading-relaxed mb-4">{description}</p>
            </div>
            <div class="flex items-center justify-between">
                <div class="flex gap-2 flex-wrap">
                    {tags.map((tag) => (
                        <span class="text-[10px] font-medium py-1 px-2.5 border border-border rounded-full text-ink-faint">{tag}</span>
                    ))}
                </div>
                <svg class="w-4 h-4 text-ink-faint group-hover:text-accent transition-colors duration-300 shrink-0 ml-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 12L12 4M12 4H6M12 4v6"/>
                </svg>
            </div>
        </div>
        <!-- Image -->
        <div class="w-full md:w-48 lg:w-56 shrink-0 overflow-hidden bg-surface-warm order-1 md:order-2 rounded-t-xl md:rounded-t-none md:rounded-r-xl">
            <img
                src={image}
                alt={title}
                loading="lazy"
                class="w-full h-48 md:h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />
        </div>
    </div>
</a>
