---
export interface ProjectLink {
  type: 'github' | 'demo' | 'external' | string;
  label: string;
  url: string;
}

interface Props {
	id: string;
	category: string;
	title: string;
	description: string;
	image?: string;
	gradientStyle?: string;
	accentColor?: string;
	iconType?: 'soc' | 'career' | 'social' | 'agri' | string;
	tags: string[];
	links?: ProjectLink[];
}

const {
	id,
	category,
	title,
	description,
	image,
	gradientStyle = "from-slate-950 via-slate-900 to-slate-950",
	accentColor = "#c45d5d",
	iconType = "default",
	tags = [],
	links = []
} = Astro.props;
---

<div class="card flex flex-col justify-between h-full group bg-surface">
    <!-- Cover Container (Gradient or Image) -->
    <div class="relative w-full h-48 md:h-52 overflow-hidden rounded-t-xl bg-surface-warm group/cover shrink-0">
        {image ? (
            <img
                src={image}
                alt={title}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover/cover:scale-[1.03]"
            />
        ) : (
            <div class={`w-full h-full bg-gradient-to-br ${gradientStyle} relative flex items-center justify-center overflow-hidden transition-transform duration-700 ease-out group-hover/cover:scale-[1.02]`}>
                <!-- Subtle Grid Pattern Overlay -->
                <div class="absolute inset-0 opacity-15 pointer-events-none" style="background-image: radial-gradient(rgba(255, 255, 255, 0.4) 1px, transparent 1px); background-size: 16px 16px;"></div>

                <!-- Ambient Glowing Orbs -->
                <div class="absolute -top-10 -right-10 w-44 h-44 rounded-full blur-2xl opacity-40 pointer-events-none group-hover/cover:opacity-70 transition-opacity duration-500" style={`background-color: ${accentColor};`}></div>
                <div class="absolute -bottom-10 -left-10 w-40 h-40 rounded-full blur-2xl opacity-25 pointer-events-none" style={`background-color: ${accentColor};`}></div>

                <!-- Graphic Emblem Badge -->
                <div class="relative z-10 p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 text-white shadow-2xl transition-transform duration-500 group-hover/cover:scale-110 group-hover/cover:rotate-2">
                    {iconType === 'soc' && (
                        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M12 9v6M9 12h6"/>
                        </svg>
                    )}
                    {iconType === 'career' && (
                        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                            <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                        </svg>
                    )}
                    {iconType === 'social' && (
                        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                        </svg>
                    )}
                    {iconType === 'agri' && (
                        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                        </svg>
                    )}
                    {['soc', 'career', 'social', 'agri'].indexOf(iconType) === -1 && (
                        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                        </svg>
                    )}
                </div>

                <!-- Top Right Tag -->
                <div class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-black/40 backdrop-blur-md border border-white/10 text-[10px] font-mono tracking-wider text-white/90 uppercase">
                    {category}
                </div>
            </div>
        )}
    </div>

    <!-- Content -->
    <div class="p-6 md:p-7 flex flex-col justify-between flex-1">
        <div>
            <div class="flex items-center justify-between text-[10px] font-medium uppercase tracking-widest text-ink-faint mb-2">
                <span>{id}</span>
                <span>{category}</span>
            </div>

            <h3 class="font-medium text-xl md:text-2xl mb-3 text-ink group-hover:text-accent transition-colors duration-300">
                {title}
            </h3>

            <p class="text-sm text-ink-muted leading-relaxed mb-6">
                {description}
            </p>
        </div>

        <div>
            <!-- Tags -->
            <div class="flex gap-2 flex-wrap mb-6">
                {tags.map((tag) => (
                    <span class="text-[10px] font-medium py-1 px-2.5 border border-border rounded-full text-ink-faint bg-surface-warm/50">
                        {tag}
                    </span>
                ))}
            </div>

            <!-- Links with Icons -->
            {links && links.length > 0 ? (
                <div class="flex items-center gap-3 pt-4 border-t border-border-subtle flex-wrap">
                    {links.map((link) => (
                        <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-medium rounded-full border border-border text-ink bg-surface hover:bg-ink hover:text-surface hover:border-ink transition-all duration-200 group/btn shadow-xs"
                        >
                            {link.type === 'github' && (
                                <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                                </svg>
                            )}
                            {link.type === 'demo' && (
                                <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2 shrink-0" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="2" y1="12" x2="22" y2="12"/>
                                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                                </svg>
                            )}
                            {link.type === 'external' && (
                                <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2 shrink-0" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                                    <polyline points="15 3 21 3 21 9"/>
                                    <line x1="10" y1="14" x2="21" y2="3"/>
                                </svg>
                            )}
                            <span>{link.label}</span>
                            <svg class="w-3 h-3 text-ink-faint group-hover/btn:text-surface group-hover/btn:translate-x-0.5 transition-transform duration-200 shrink-0" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M1 7h12M8 2l5 5-5 5"/>
                            </svg>
                        </a>
                    ))}
                </div>
            ) : (
                <div class="flex items-center gap-2 pt-4 border-t border-border-subtle text-xs text-ink-faint">
                    <span class="inline-block w-2 h-2 rounded-full bg-amber-500/80 animate-pulse"></span>
                    <span>Architecture / In Development</span>
                </div>
            )}
        </div>
    </div>
</div>

