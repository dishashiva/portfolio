---
interface Props {
	date: string;
	title: string;
	company: string;
	icon: string;
	theme: 'pink' | 'yellow' | 'red';
}

const { date, title, company, icon, theme } = Astro.props;

const iconTextRender = {
    pink: 'text-pink group-hover:bg-pink group-hover:text-white',
    yellow: 'text-yellow group-hover:bg-yellow group-hover:text-dark-green',
    red: 'text-red group-hover:bg-red group-hover:text-white',
}

const shadowRender = {
    pink: 'shadow-[0_0_0_4px_rgba(255,126,185,0.2)]',
    yellow: 'shadow-[0_0_0_4px_rgba(244,255,94,0.3)]',
    red: 'shadow-[0_0_0_4px_rgba(255,62,62,0.2)]'
}

const textRender = {
    pink: 'text-pink',
    yellow: 'text-yellow',
    red: 'text-red'
}
---
<div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group">
    <div class={`flex items-center justify-center w-14 h-14 rounded-full border-4 border-white bg-dark-green ${iconTextRender[theme]} group-hover:scale-110 transition-all ${shadowRender[theme]} z-10 shrink-0 md:order-1 md:absolute md:left-1/2 md:-translate-x-1/2`}>
        <i data-lucide={icon} class="w-5 h-5"></i>
    </div>
    <!-- Card -->
    <div class="glass-card rounded-2xl p-6 md:p-8 w-[calc(100%-5rem)] md:w-[calc(50%-3rem)] transition-all hover:-translate-y-2">
        <div class="flex justify-between items-start mb-2">
            <span class={`text-xs font-bold ${textRender[theme]} uppercase tracking-widest`}>{date}</span>
        </div>
        <h3 class="serif text-2xl mb-2">{title}</h3>
        <p class="text-neutral-500 text-sm">{company}</p>
    </div>
</div>
