---
interface Props {
	date: string;
	title: string;
	company: string;
	icon: string;
	theme: 'accent' | 'muted' | 'warm';
}

const { date, title, company, icon, theme } = Astro.props;

const dotColor = {
    accent: 'bg-accent',
    muted: 'bg-ink-faint',
    warm: 'bg-amber-400',
};

const iconColor = {
    accent: 'text-accent',
    muted: 'text-ink-faint',
    warm: 'text-amber-500',
};
---

<div class="flex items-start gap-6 py-8 border-b border-border-subtle last:border-b-0 group">
    <div class="relative shrink-0 mt-1">
        <div class={`w-2 h-2 rounded-full ${dotColor[theme]}`}></div>
    </div>

    <div class="flex-1 min-w-0">
        <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 mb-1">
            <h3 class="font-medium text-base text-ink">{title}</h3>
            <span class="text-xs text-ink-faint shrink-0">{date}</span>
        </div>
        <p class="text-sm text-ink-muted">{company}</p>
    </div>
</div>
