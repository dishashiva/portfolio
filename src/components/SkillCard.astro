---
interface Props {
	title: string;
	icon: string;
}

const { title, icon } = Astro.props;
---

<div class="border border-border-subtle rounded-xl p-4 md:p-5 group hover:border-border transition-colors duration-300">
    <i data-lucide={icon} class="w-4 h-4 text-ink-faint mb-3 group-hover:text-accent transition-colors duration-300"></i>
    <h3 class="font-medium text-sm text-ink">{title}</h3>
</div>
